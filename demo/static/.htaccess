# Honar Afagh static demo — optional hints for Apache / LiteSpeed (cPanel).
# The demo works without this file; it only improves MIME types, caching and 404 handling.

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/gzip .tgz
  AddType application/octet-stream .data
  AddType text/plain .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 {{BASE}}/404.html
