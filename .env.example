# ─────────────────────────────────────────────────────────────────────────────
# Honar Afagh platform — environment configuration
# Copy to .env and adjust. Never commit real secrets.
# Every variable is validated at startup (src/server/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
DATABASE_URL=postgres://honar:honar@localhost:5432/honar
# Public base URL (used for payment callbacks and links in SMS).
APP_URL=http://localhost:3000
# ≥ 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Demo mode: shows demo credentials on login pages and allows fake providers in production.
DEMO_MODE=true
# Run the outbox dispatcher and periodic jobs inside the web process (dev only).
# In production set false and run `pnpm worker` as a separate process.
WORKER_INLINE=true
BUSINESS_TIMEZONE=Asia/Tehran

# OTP / SMS — "fake" logs codes locally (dev/demo), "smsir" sends via SMS.ir
OTP_PROVIDER=fake
SMS_PROVIDER=fake
SMSIR_API_KEY=
# Verification template id approved in the SMS.ir panel; the template must contain the parameter below.
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAM_NAME=CODE
# Dedicated line number for transactional (non-OTP) messages.
SMSIR_LINE_NUMBER=

# Online payment — "fake" is an internal sandbox page, "zarinpal" uses Zarinpal REST v4
PAYMENT_PROVIDER=fake
ZARINPAL_MERCHANT_ID=
# true = sandbox.zarinpal.com
ZARINPAL_SANDBOX=true

# File storage — "local" writes to STORAGE_LOCAL_DIR; "s3" uses any S3-compatible service
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Max upload size for artwork (bytes). Images are additionally capped at 15 MB.
UPLOAD_MAX_BYTES=157286400

# Accounting — "internal" (default) or "holoo" (adapter awaiting API specification)
ACCOUNTING_PROVIDER=internal
HOLOO_BASE_URL=
HOLOO_API_KEY=

# Seed only: password for demo staff accounts (defaults to the documented demo password)
# SEED_STAFF_PASSWORD=
